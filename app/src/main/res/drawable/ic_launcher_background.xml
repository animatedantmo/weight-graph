<?xml version="1.0" encoding="utf-8"?>
<!--
    Solid background layer for the adaptive launcher icon. The colour is defined per build type
    in app/build.gradle.kts — indigo for the real app, red for a side-by-side install built on a
    secondary machine. The foreground is pure white and works over any reasonably dark colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/launcher_background"
        android:pathData="M0,0h108v108h-108z" />
</vector>
