<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground: a weight line chart plotting 200, 180, 190, 170 lb across
    Sunday to Wednesday.

    VectorDrawable has no text element, so the axis labels (200, 170, S, M, T, W) are drawn
    as stencil stroke paths rather than glyph outlines. At the 5-unit cap height used here
    that is visually identical to real type and avoids baking in a font.

    Everything sits inside roughly x/y 22..89 of the 108 canvas, so it survives the circular
    and squircle masks launchers apply. All strokes are white so this doubles as the
    monochrome layer for Android 13+ themed icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Axes -->
    <path
        android:pathData="M38,25 L38,74 L89,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeAlpha="0.65"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Weight line: 200 down to 180, up to 190, down to 170 -->
    <path
        android:pathData="M48,28 L60,54 L71,41 L83,67"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Data points -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44.7,28 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0z
                          M56.7,54 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0z
                          M67.7,41 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0z
                          M79.7,67 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0z" />

    <!-- Y axis label: 200 -->
    <path
        android:pathData="M22,26 L25.6,26 L25.6,28.5 L22,28.5 L22,31 L25.6,31
                          M26.7,26 L30.3,26 L30.3,31 L26.7,31 Z
                          M31.4,26 L35,26 L35,31 L31.4,31 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Y axis label: 170 -->
    <path
        android:pathData="M23.8,65 L23.8,70
                          M26.7,65 L30.3,65 L28.5,70
                          M31.4,65 L35,65 L35,70 L31.4,70 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- X axis labels: S M T W -->
    <path
        android:pathData="M50.25,80.5 L45.75,80.5 L45.75,83.25 L50.25,83.25 L50.25,86 L45.75,86
                          M57.75,86 L57.75,80.5 L60,83.25 L62.25,80.5 L62.25,86
                          M68.75,80.5 L73.25,80.5 M71,80.5 L71,86
                          M80.75,80.5 L81.875,86 L83,83.25 L84.125,86 L85.25,80.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
